          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 50,
            "maximum": 5000,
            "default": 2000
          },
          "value_b64": {
            "type": "string",
            "maxLength": 21848,
            "contentEncoding": "base64",
            "x-canonical-base64-max-decoded-bytes": 16384
          }
        },
        "required": [
          "key",
          "client_id",
          "sequence",
          "value_b64"
        ],
        "additionalProperties": false
      },
